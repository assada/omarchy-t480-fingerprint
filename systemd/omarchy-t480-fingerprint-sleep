#!/bin/bash

# Recover the Synaptics 06cb:009a reader across suspend and hibernation.

set -u

readonly sensor_vendor="06cb"
readonly sensor_product="009a"
readonly sysfs_root="${OMARCHY_T480_FINGERPRINT_SYSFS_ROOT:-/sys/bus/usb/devices}"
readonly state_directory="${OMARCHY_T480_FINGERPRINT_RUN_DIR:-/run/omarchy-t480-fingerprint}"
readonly resume_marker="$state_directory/resume-backend"

log_message() {
  logger --tag omarchy-t480-fingerprint -- "$*"
}

sensor_is_present() {
  local device vendor product
  for device in "$sysfs_root"/*; do
    [[ -r "$device/idVendor" && -r "$device/idProduct" ]] || continue
    read -r vendor <"$device/idVendor"
    read -r product <"$device/idProduct"
    [[ "$vendor" == "$sensor_vendor" && "$product" == "$sensor_product" ]] && return 0
  done
  return 1
}

backend_has_device() {
  gdbus call --system \
    --dest net.reactivated.Fprint \
    --object-path /net/reactivated/Fprint/Manager \
    --method net.reactivated.Fprint.Manager.GetDevices 2>/dev/null |
    grep -q '/net/reactivated/Fprint/Device/'
}

wait_for_sensor() {
  local attempt
  for ((attempt = 1; attempt <= 100; attempt++)); do
    sensor_is_present && return 0
    sleep 0.1
  done
  return 1
}

wait_for_backend() {
  local attempt
  for ((attempt = 1; attempt <= 100; attempt++)); do
    backend_has_device && return 0
    sleep 0.1
  done
  return 1
}

stop_backend() {
  systemctl stop python3-validity.service || true
  systemctl stop open-fprintd.service || true
}

start_backend() {
  systemctl start open-fprintd.service || return 1
  systemctl start python3-validity.service || return 1
}

before_sleep() {
  if ! sensor_is_present; then
    return 0
  fi
  if ! systemctl is-active --quiet python3-validity.service &&
    ! systemctl is-active --quiet open-fprintd.service; then
    return 0
  fi

  install -d -m 755 "$state_directory"
  touch "$resume_marker"
  stop_backend
  log_message "Stopped the fingerprint backend before ${2:-sleep}."
}

after_sleep() {
  if [[ ! -f "$resume_marker" ]]; then
    return 0
  fi
  rm -f -- "$resume_marker"

  if ! wait_for_sensor; then
    log_message "The fingerprint reader did not return after ${2:-sleep}."
    return 1
  fi

  udevadm settle --timeout=10 || true
  if ! start_backend; then
    log_message "The fingerprint services did not start after ${2:-sleep}."
    return 1
  fi
  if ! wait_for_backend; then
    log_message "The fingerprint backend did not publish a device after ${2:-sleep}."
    return 1
  fi

  log_message "The fingerprint reader is ready after ${2:-sleep}."
}

case "${1:-}" in
pre) before_sleep "$@" ;;
post) after_sleep "$@" ;;
*) exit 0 ;;
esac
