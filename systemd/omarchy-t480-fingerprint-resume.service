[Unit]
Description=Re-open the ThinkPad T480 fingerprint reader after sleep
Documentation=https://github.com/assada/omarchy-t480-fingerprint
# A unit ordered after the sleep targets runs once the resume is complete, so it
# does not hold up the thaw of the user session. A script in
# /usr/lib/systemd/system-sleep does hold it up, because systemd-sleep waits for
# every hook before it finishes the resume.
After=suspend.target hibernate.target hybrid-sleep.target suspend-then-hibernate.target
ConditionFileIsExecutable=/usr/local/lib/omarchy-t480-fingerprint/omarchy-t480-fingerprint-resume

[Service]
Type=oneshot
ExecStart=/usr/local/lib/omarchy-t480-fingerprint/omarchy-t480-fingerprint-resume
# Covers the bounded waits in the script: the reader coming back, the sensor
# re-opening, and one restart of the backend as the last resort.
TimeoutStartSec=120

[Install]
WantedBy=suspend.target hibernate.target hybrid-sleep.target suspend-then-hibernate.target
